{% liquid
  assign embedded_header = "data:image/jpeg;base64,"
%}

<header class="d99-art-header" role="banner">
  <div class="d99-art-header__wrap page-width">
    <div class="d99-art-header__frame">
      <img src="{{ embedded_header }}" alt="DISTRICT-99 header" class="d99-art-header__image" loading="eager">

      <a class="d99-art-header__hotspot hs-home" href="{{ routes.root_url }}" aria-label="Home"></a>
      <a class="d99-art-header__hotspot hs-shop" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}" aria-label="Shop"></a>
      <a class="d99-art-header__hotspot hs-collections" href="{{ section.settings.collections_link | default: routes.all_products_collection_url }}" aria-label="Collections"></a>
      <a class="d99-art-header__hotspot hs-about" href="{{ section.settings.about_link | default: '/pages/about' }}" aria-label="About"></a>
      <a class="d99-art-header__hotspot hs-lookbook" href="{{ section.settings.lookbook_link | default: '/pages/lookbook' }}" aria-label="Lookbook"></a>
      <a class="d99-art-header__hotspot hs-contact" href="{{ section.settings.contact_link | default: '/pages/contact' }}" aria-label="Contact"></a>
      <a class="d99-art-header__hotspot hs-cart" href="{{ routes.cart_url }}" aria-label="Cart"></a>
    </div>
  </div>
</header>

<style>
  .shopify-section-group-header-group .announcement-bar,
  .shopify-section-group-header-group .announcement-bar-section,
  .shopify-section-group-header-group [id*='announcement'],
  .shopify-section-group-header-group [class*='announcement'] {
    display: none !important;
    visibility: hidden !important;
    max-height: 0 !important;
    min-height: 0 !important;
    height: 0 !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .d99-art-header {
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
    border: 0 !important;
  }

  .d99-art-header__wrap {
    max-width: 100% !important;
    padding: 1rem 1.4rem 0 !important;
    margin: 0 !important;
  }

  .d99-art-header__frame {
    position: relative;
    width: 100%;
    max-width: 149.5rem;
    margin: 0 auto;
  }

  .d99-art-header__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .d99-art-header__hotspot {
    position: absolute;
    display: block;
    z-index: 2;
    background: transparent;
  }

  .shopify-design-mode .d99-art-header__hotspot:hover,
  .shopify-design-mode .d99-art-header__hotspot:focus-visible {
    outline: 1px dashed rgba(255, 0, 0, 0.5);
    outline-offset: -1px;
  }

  .hs-home { left: 0.8%; top: 76%; width: 12%; height: 19%; }
  .hs-shop { left: 28.4%; top: 80.2%; width: 6.5%; height: 12%; }
  .hs-collections { left: 37.1%; top: 80.2%; width: 10.8%; height: 12%; }
  .hs-about { left: 50.7%; top: 80.2%; width: 7.2%; height: 12%; }
  .hs-lookbook { left: 61.8%; top: 80.2%; width: 8.8%; height: 12%; }
  .hs-contact { left: 74.4%; top: 80.2%; width: 8.2%; height: 12%; }
  .hs-cart { right: 0.5%; top: 77.6%; width: 9.4%; height: 15%; }

  @media screen and (max-width: 990px) {
    .d99-art-header__wrap {
      padding: 0.6rem 0.8rem 0 !important;
    }
  }
</style>

{% schema %}
{
  "name": "D99 System Header",
  "class": "section-header",
  "settings": [
    { "type": "url", "id": "shop_link", "label": "Shop link" },
    { "type": "url", "id": "collections_link", "label": "Collections link" },
    { "type": "url", "id": "about_link", "label": "About link" },
    { "type": "url", "id": "lookbook_link", "label": "Lookbook link" },
    { "type": "url", "id": "contact_link", "label": "Contact link" }
  ]
}
{% endschema %}
