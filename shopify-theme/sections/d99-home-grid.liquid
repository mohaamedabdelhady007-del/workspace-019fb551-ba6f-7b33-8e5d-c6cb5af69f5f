    background: transparent !important;
    color: var(--d99-black) !important;
    padding: 0;
    font-size: 2rem;
    justify-self: end;
    cursor: pointer;
  }

  .d99-home-v3__footer-cell--globe {
    justify-content: center;
  }

  .d99-home-v3__globe {
    position: relative;
    width: 7rem;
    height: 7rem;
    border: 1px solid rgba(18,18,18,.7);
    border-radius: 50% !important;
    display: inline-block;
  }

  .d99-home-v3__globe::before {
    transform: scaleX(0.42);
  }

  .d99-home-v3__globe::after {
    transform: scaleY(0.42);
  }

  .d99-home-v3__globe {
    box-shadow: inset 0 0 0 1px transparent;
  }

  .d99-home-v3__globe span {
    display: none;
  }

  @media screen and (max-width: 1200px) {
    .d99-home-v3__navrow,
    .d99-home-v3__hero-grid,
    .d99-home-v3__bottom-grid,
    .d99-home-v3__footer-grid {
      grid-template-columns: 1fr !important;
    }

    .d99-home-v3__navrow {
      gap: 1.4rem;
    }

    .d99-home-v3__brandmark,
    .d99-home-v3__cartlink {
      text-align: left;
    }

    .d99-home-v3__left-cards {
      grid-template-columns: 1fr 1fr;
    }

    .d99-home-v3__poster-card,
    .d99-home-v3__accessory-card {
      min-height: 42rem;
    }
  }

  @media screen and (max-width: 768px) {
    .d99-home-v3__masthead,
    .d99-home-v3__submeta {
      padding-left: 1.2rem;
      padding-right: 1.2rem;
    }

    .d99-home-v3__nav {
      justify-content: flex-start;
      gap: 1.6rem 2.2rem;
    }

    .d99-home-v3__submeta {
      flex-direction: column;
    }

    .d99-home-v3__hero-left,
    .d99-home-v3__hero-right {
