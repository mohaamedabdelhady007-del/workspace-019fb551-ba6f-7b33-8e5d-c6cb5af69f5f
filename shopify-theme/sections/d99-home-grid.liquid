{% liquid
  assign artboard_image = section.settings.desktop_artboard
  assign fallback_artboard = 'https://raw.githubusercontent.com/mohaamedabdelhady007-del/workspace-019fb551-ba6f-7b33-8e5d-c6cb5af69f5f/e4d707941eb8f079c49c84bd4a278e9cd3e9caef/uploads/theme-design-mockups/homepage_option_3.jpg'
%}

<section class="d99-home-artboard-shell page-width">
  <div class="d99-home-artboard">
    {% if artboard_image != blank %}
      {{ artboard_image | image_url: width: 2200 | image_tag: loading: 'eager', alt: 'DISTRICT-99 homepage mockup', class: 'd99-home-artboard__image' }}
    {% else %}
      <img src="{{ fallback_artboard }}" alt="DISTRICT-99 homepage mockup" class="d99-home-artboard__image" loading="eager">
    {% endif %}

    <a class="d99-home-artboard__hotspot hs-shop" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}" aria-label="Shop"></a>
    <a class="d99-home-artboard__hotspot hs-collections" href="{{ section.settings.collections_link | default: routes.all_products_collection_url }}" aria-label="Collections"></a>
    <a class="d99-home-artboard__hotspot hs-about" href="{{ section.settings.about_link | default: '/pages/about' }}" aria-label="About"></a>
    <a class="d99-home-artboard__hotspot hs-lookbook" href="{{ section.settings.lookbook_link | default: '/pages/lookbook' }}" aria-label="Lookbook"></a>
    <a class="d99-home-artboard__hotspot hs-contact" href="{{ section.settings.contact_link | default: '/pages/contact' }}" aria-label="Contact"></a>
    <a class="d99-home-artboard__hotspot hs-cart" href="{{ routes.cart_url }}" aria-label="Cart"></a>

    <a class="d99-home-artboard__hotspot hs-hero-cta" href="{{ section.settings.hero_cta_link | default: routes.all_products_collection_url }}" aria-label="Shop now"></a>

    <a class="d99-home-artboard__hotspot hs-product-card" href="{{ section.settings.product_card_link | default: routes.all_products_collection_url }}" aria-label="View product"></a>
    <a class="d99-home-artboard__hotspot hs-explore" href="{{ section.settings.explore_link | default: routes.all_products_collection_url }}" aria-label="Explore"></a>
    <a class="d99-home-artboard__hotspot hs-lookbook-card" href="{{ section.settings.lookbook_card_link | default: '/pages/lookbook' }}" aria-label="View lookbook"></a>
    <a class="d99-home-artboard__hotspot hs-accessory-card" href="{{ section.settings.accessory_link | default: routes.all_products_collection_url }}" aria-label="View accessory"></a>

    {% form 'customer', id: 'D99ArtboardNewsletter-' | append: section.id, class: 'd99-home-artboard__newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        class="d99-home-artboard__newsletter-input"
        type="email"
        name="contact[email]"
        value="{% if customer %}{{ customer.email }}{% endif %}"
        placeholder="Enter your email"
        aria-label="Enter your email"
      >
      <button type="submit" class="d99-home-artboard__newsletter-button" aria-label="Submit newsletter"></button>
    {% endform %}
  </div>
</section>

<style>
  .shopify-section-group-header-group,
  .shopify-section-group-footer-group,
  .section-header,
  footer.footer,
  .footer,
  sticky-header,
  header.header,
  .shopify-section:has(.header-wrapper),
  .shopify-section:has(.footer-wrapper),
  #shopify-section-sections--header-group,
  #shopify-section-sections--footer-group {
    display: none !important;
    visibility: hidden !important;
    max-height: 0 !important;
    height: 0 !important;
    min-height: 0 !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  body,
  body.template-index,
  #MainContent,
  main {
    background: #d7d1c8 !important;
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  .d99-home-artboard-shell {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .d99-home-artboard {
    position: relative;
    width: 100%;
    max-width: 150rem;
    margin: 0 auto;
    background: #d7d1c8;
  }

  .d99-home-artboard__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .d99-home-artboard__hotspot,
  .d99-home-artboard__newsletter-form {
    position: absolute;
    display: block;
    z-index: 2;
  }

  .d99-home-artboard__hotspot {
    background: transparent;
  }

  .shopify-design-mode .d99-home-artboard__hotspot:hover,
  .shopify-design-mode .d99-home-artboard__hotspot:focus-visible {
    outline: 1px dashed rgba(255, 0, 0, 0.55);
    outline-offset: -1px;
  }

  .hs-shop { left: 28.2%; top: 11.15%; width: 5.6%; height: 2.3%; }
  .hs-collections { left: 35.7%; top: 11.15%; width: 9.4%; height: 2.3%; }
  .hs-about { left: 49.0%; top: 11.15%; width: 5.7%; height: 2.3%; }
  .hs-lookbook { left: 57.4%; top: 11.15%; width: 8.2%; height: 2.3%; }
  .hs-contact { left: 68.7%; top: 11.15%; width: 7.0%; height: 2.3%; }
  .hs-cart { right: 1.1%; top: 11.0%; width: 6.5%; height: 2.5%; }

  .hs-hero-cta { right: 1.5%; top: 60.55%; width: 18.4%; height: 4.6%; }

  .hs-product-card { left: 2.1%; top: 81.4%; width: 13.4%; height: 3.2%; }
  .hs-explore { left: 22.8%; top: 82.0%; width: 10.0%; height: 2.8%; }
  .hs-lookbook-card { left: 22.9%; top: 95.05%; width: 8.4%; height: 2.5%; }
  .hs-accessory-card { right: 1.7%; top: 87.7%; width: 14.3%; height: 9.0%; }

  .d99-home-artboard__newsletter-form {
    left: 69.5%;
    top: 95.35%;
    width: 22.2%;
    height: 2.6%;
    display: grid;
    grid-template-columns: 1fr 3.2rem;
    align-items: end;
    gap: 0.6rem;
  }

  .d99-home-artboard__newsletter-input {
    width: 100%;
    border: 0;
    background: transparent;
    color: transparent;
    caret-color: transparent;
    outline: none;
    padding: 0;
    font-size: 1.2rem;
  }

  .d99-home-artboard__newsletter-input::placeholder {
    color: transparent;
  }

  .d99-home-artboard__newsletter-button {
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @media screen and (max-width: 900px) {
    .d99-home-artboard {
      max-width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function hideHorizonShell() {
      var selectors = [
        '.shopify-section-group-header-group',
        '.shopify-section-group-footer-group',
        '.section-header',
        'footer.footer',
        '.footer',
        'sticky-header',
        'header.header',
        '.shopify-section:has(.header-wrapper)',
        '.shopify-section:has(.footer-wrapper)',
        '#shopify-section-sections--header-group',
        '#shopify-section-sections--footer-group'
      ];

      selectors.forEach(function (selector) {
        document.querySelectorAll(selector).forEach(function (element) {
          if (element.closest('.d99-home-artboard-shell')) return;
          element.style.display = 'none';
          element.style.visibility = 'hidden';
          element.style.height = '0';
          element.style.maxHeight = '0';
          element.style.minHeight = '0';
          element.style.overflow = 'hidden';
          element.style.opacity = '0';
          element.style.pointerEvents = 'none';
        });
      });

      var mainContent = document.getElementById('MainContent');
      if (mainContent) {
        mainContent.style.marginTop = '0';
        mainContent.style.paddingTop = '0';
      }

      document.body.style.background = '#d7d1c8';
    }

    hideHorizonShell();
    new MutationObserver(hideHorizonShell).observe(document.documentElement, { childList: true, subtree: true });
  });
</script>

{% schema %}
{
  "name": "D99 Home Grid",
  "settings": [
    { "type": "image_picker", "id": "desktop_artboard", "label": "Desktop artboard image" },
    { "type": "url", "id": "shop_link", "label": "Shop link" },
    { "type": "url", "id": "collections_link", "label": "Collections link" },
    { "type": "url", "id": "about_link", "label": "About link" },
    { "type": "url", "id": "lookbook_link", "label": "Top lookbook link" },
    { "type": "url", "id": "contact_link", "label": "Contact link" },
    { "type": "url", "id": "hero_cta_link", "label": "Hero CTA link" },
    { "type": "url", "id": "product_card_link", "label": "Left product card link" },
    { "type": "url", "id": "explore_link", "label": "Explore card link" },
    { "type": "url", "id": "lookbook_card_link", "label": "Lower lookbook card link" },
    { "type": "url", "id": "accessory_link", "label": "Accessory card link" }
  ],
  "presets": [
    { "name": "D99 Home Grid" }
  ]
}
{% endschema %}
