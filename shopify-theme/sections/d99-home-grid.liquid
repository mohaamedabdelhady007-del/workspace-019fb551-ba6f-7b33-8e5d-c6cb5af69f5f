  .d99-home-v3__scribble {
    position: absolute;
    border: 2px solid rgba(18,18,18,.24);
    border-radius: 50% !important;
    pointer-events: none;
  }

  .d99-home-v3__scribble--one {
    width: 47rem;
    height: 17rem;
    bottom: 7rem;
    left: 11rem;
    transform: rotate(17deg);
