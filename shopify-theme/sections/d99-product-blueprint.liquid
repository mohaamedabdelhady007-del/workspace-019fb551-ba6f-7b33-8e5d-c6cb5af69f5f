{% assign current_variant = product.selected_or_first_available_variant %}
{% assign current_image = current_variant.featured_media.preview_image | default: product.featured_image %}

<section class="page-width d99-page d99-blueprint-page">
  <div class="d99-topline">
    <span>D99 &nbsp; SYS_VER 2.4.1 &nbsp; BUILD 05.24</span>
    <span>WAREHOUSE // <span class="d99-red">ONLINE</span> &nbsp; | &nbsp; LOGIN &nbsp; | &nbsp; CART [{{ cart.item_count }}]</span>
  </div>

  <div class="d99-panel" style="margin:0; padding: 2rem 2.4rem; display:grid; grid-template-columns: 1fr 26rem; align-items:center;">
    <div>
      <img src="{{ 'd99-logo-header-black.png' | asset_url }}" alt="{{ shop.name }}" style="max-width: 58rem; width:100%; height:auto; display:block;">
    </div>
    <div class="d99-copy" style="text-transform:uppercase; font-size:1.2rem; justify-self:end; text-align:left; color:var(--d99-ink);">
      {{ section.settings.blueprint_status | newline_to_br }}
    </div>
  </div>

  <div class="d99-topline">
    <div style="display:flex; gap:4rem; flex-wrap:wrap;">
      <a href="{{ routes.all_products_collection_url }}" style="text-decoration:none; font-weight:600; background:#f4c927; padding:.2rem .8rem;">Shop</a>
      <a href="{{ routes.all_products_collection_url }}">Collections</a>
      <a href="/pages/about">About</a>
      <a href="/pages/contact">Contact</a>
      <a href="/pages/archive">Archive</a>
    </div>
    <div style="display:flex; gap:3rem;"><span>IG</span><span>TT</span><span>X</span></div>
  </div>

  <div class="d99-grid d99-blueprint-grid" style="grid-template-columns: 29rem minmax(0, 1.2fr) 14rem 1fr;">
    <div class="d99-panel" style="padding: 2rem; display:grid; gap:1.4rem; align-content:start;">
      <div class="d99-micro">SHOP &gt; TOPS &gt; {{ product.handle | upcase }}</div>
      <div class="d99-micro">{{ product.handle | upcase }}</div>
      <h1 class="d99-heading-page" style="font-size: 5rem !important;">{{ product.title }}</h1>
      <div style="font-size: 2.2rem;">{{ current_variant.price | money }}</div>
      <div class="d99-copy" style="font-size:1.15rem; text-transform:uppercase;">Color: {{ product.metafields.custom.color.value | default: 'Black' }}</div>

      {% form 'product', product, id: 'D99BlueprintForm-' | append: section.id %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="D99BlueprintVariant-{{ section.id }}">
        <div class="d99-micro">Size: [ Select size ]</div>
        <div style="display:flex; gap:.8rem; flex-wrap:wrap; margin-bottom:1.4rem;">
          {% for variant in product.variants %}
            <button type="button" class="d99-square-option{% if variant.id == current_variant.id %} is-active{% endif %}{% unless variant.available %} is-disabled{% endunless %}" data-blueprint-variant="{{ section.id }}" data-variant-id="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</button>
          {% endfor %}
        </div>
        <button type="submit" class="d99-btn" style="width:100%; justify-content:center; background:#f4c927; color:#111 !important; font-size:1.8rem;">Add to cart ⊕</button>
      {% endform %}

      <div class="d99-sort-link">+ Add to wishlist</div>
      <div class="d99-panel" style="margin:0; padding:1.6rem;">
        <ul class="d99-meta-list">
          <li><span>SKU</span><span>{{ current_variant.sku | default: product.handle | upcase }}</span></li>
          <li><span>Category</span><span>{{ product.type | default: 'Tops / T-shirts' }}</span></li>
          <li><span>Material</span><span>{{ product.metafields.custom.material.value | default: '100% cotton' }}</span></li>
          <li><span>Weight</span><span>{{ product.metafields.custom.fabric_weight.value | default: '300 GSM' }}</span></li>
          <li><span>Fit</span><span>{{ product.metafields.custom.fit.value | default: 'Oversized' }}</span></li>
          <li><span>Ships within</span><span>24–48 hours</span></li>
        </ul>
      </div>
    </div>

    <div class="d99-panel" style="padding:1.6rem;">
      <div class="d99-product-media" style="aspect-ratio:0.72;">
        {% if current_image != blank %}
          <img id="D99BlueprintMedia-{{ section.id }}" src="{{ current_image | image_url: width: 1800 }}" alt="{{ product.title }}">
        {% else %}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>

    <div class="d99-grid" style="grid-template-rows: repeat(4, 1fr); gap:1rem; padding:1.6rem;">
      {% for media in product.media limit: 4 %}
        {% if media.media_type == 'image' %}
          <button class="d99-thumb{% if forloop.first %} is-active{% endif %}" type="button" data-blueprint-thumb="{{ section.id }}" data-src="{{ media | image_url: width: 1600 }}">{{ media | image_url: width: 320 | image_tag: loading: 'lazy', alt: product.title }}</button>
        {% endif %}
      {% endfor %}
    </div>

    <div class="d99-panel" style="padding: 1rem; display:grid; gap:1rem; align-content:start;">
      <div class="d99-topline" style="padding:.8rem 1rem;"><span>// Technical specifications</span><span>SEQ. 0099.2024</span></div>
      <div class="d99-grid" style="grid-template-columns: 1fr 1fr; gap:0;">
        <div class="d99-panel" style="margin:0; padding:1.2rem; min-height:34rem;">
          <ul class="d99-spec-list">
            <li><span>Material composition</span><span>100% cotton</span></li>
            <li><span>Fabric weight</span><span>300 GSM</span></li>
            <li><span>Construction</span><span>Tubular</span></li>
            <li><span>Print type</span><span>Screen print</span></li>
            <li><span>Neckline</span><span>Ribbed crewneck</span></li>
            <li><span>Sleeve length</span><span>Short sleeve</span></li>
            <li><span>Fit type</span><span>Oversized</span></li>
            <li><span>Care</span><span>Machine wash cold</span></li>
          </ul>
        </div>
        <div class="d99-panel" style="margin:0; padding:1.2rem; min-height:34rem; display:grid; place-items:center;">
          <svg viewBox="0 0 340 260" style="width:100%; height:auto; max-width:29rem;">
            <path d="M90 55 Q170 15 250 55 L300 105 L274 133 L252 120 L252 218 H88 V120 L66 133 L40 105 Z" fill="none" stroke="rgba(18,18,18,.75)" stroke-width="3"/>
            <path d="M125 56 Q170 82 215 56" fill="none" stroke="rgba(18,18,18,.75)" stroke-width="2"/>
            <line x1="88" y1="132" x2="252" y2="132" stroke="rgba(18,18,18,.55)" stroke-width="1"/>
            <line x1="270" y1="78" x2="270" y2="216" stroke="var(--d99-red)" stroke-width="2"/>
            <line x1="88" y1="220" x2="252" y2="220" stroke="var(--d99-red)" stroke-width="2"/>
            <text x="170" y="238" fill="var(--d99-red)" font-size="16" text-anchor="middle" font-family="IBM Plex Mono">57.0</text>
            <text x="286" y="150" fill="var(--d99-red)" font-size="16" font-family="IBM Plex Mono">72.0</text>
          </svg>
        </div>
      </div>
      <div class="d99-grid" style="grid-template-columns: 1.25fr 1fr; gap:0;">
        <div class="d99-panel" style="margin:0; padding:1.2rem;">
          <div class="d99-topline" style="padding:.4rem 0 1rem; border:0;"><span>// Inventory data</span><span>UPDATED: 05.24.2024</span></div>
          <table class="d99-table">
            <thead><tr><th>Size</th><th>In stock</th><th>Reserved</th><th>On order</th></tr></thead>
            <tbody>
              <tr><td>S</td><td>23</td><td>5</td><td>50</td></tr>
              <tr><td>M</td><td>42</td><td>8</td><td>75</td></tr>
              <tr><td>L</td><td>31</td><td>6</td><td>75</td></tr>
              <tr><td>XL</td><td>19</td><td>3</td><td>50</td></tr>
              <tr><td>XXL</td><td>10</td><td>2</td><td>25</td></tr>
            </tbody>
          </table>
        </div>
        <div class="d99-panel" style="margin:0; padding:1.2rem; display:grid; gap:1.4rem; align-content:start;">
          <div class="d99-stamp" style="font-size:1.8rem; justify-self:end;">Limited drop</div>
          <div class="d99-barcode"></div>
          <div class="d99-copy" style="font-size:1rem; text-align:center;">{{ current_variant.sku | default: product.handle | upcase }}<br>000 199 024 556</div>
        </div>
      </div>
      <div class="d99-grid" style="grid-template-columns: 1fr .7fr; gap:0;">
        <div class="d99-panel" style="margin:0; padding:1.2rem;">
          <div class="d99-topline" style="padding:.4rem 0 1rem; border:0;"><span>// Shipping info</span><span></span></div>
          <ul class="d99-spec-list">
            <li><span>Ships from</span><span>Los Angeles, CA</span></li>
            <li><span>Shipping zone</span><span>Domestic / International</span></li>
            <li><span>Est. delivery</span><span>3–7 business days</span></li>
            <li><span>Tracking</span><span>Tracked & insured</span></li>
          </ul>
        </div>
        <div class="d99-panel" style="margin:0; padding:1.2rem;">
          <div class="d99-topline" style="padding:.4rem 0 1rem; border:0;"><span>// Product ID</span><span></span></div>
          <div class="d99-heading-page" style="font-size:4rem !important; margin:0;">D99</div>
          <div class="d99-barcode" style="margin-top:1rem;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const blueprintMedia = document.getElementById('D99BlueprintMedia-{{ section.id }}');
    document.querySelectorAll('[data-blueprint-thumb="{{ section.id }}"]').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        document.querySelectorAll('[data-blueprint-thumb="{{ section.id }}"]').forEach((item) => item.classList.remove('is-active'));
        thumb.classList.add('is-active');
        if (blueprintMedia) blueprintMedia.src = thumb.dataset.src;
      });
    });
    const blueprintVariant = document.getElementById('D99BlueprintVariant-{{ section.id }}');
    document.querySelectorAll('[data-blueprint-variant="{{ section.id }}"]').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.disabled) return;
        document.querySelectorAll('[data-blueprint-variant="{{ section.id }}"]').forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');
        blueprintVariant.value = button.dataset.variantId;
      });
    });
  });
</script>

<style>
  body.template-product.template-blueprint .shopify-section-group-header-group,
  body.template-product.template-blueprint .shopify-section-group-footer-group {
    display: none;
  }
  @media screen and (max-width: 1200px) {
    .d99-blueprint-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

{% schema %}
{
  "name": "D99 Product Blueprint",
  "settings": [
    {
      "type": "textarea",
      "id": "blueprint_status",
      "label": "Blueprint status text",
      "default": "UNITED BY DESIGN\nWORK IN PROGRESS"
    }
  ]
}
{% endschema %}
