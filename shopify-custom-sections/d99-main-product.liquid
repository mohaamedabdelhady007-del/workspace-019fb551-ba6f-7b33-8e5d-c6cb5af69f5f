<script>
  // Dynamic Image Stack Selector
  document.querySelectorAll('.d99-scaffold-bullets span').forEach(bullet => {
    bullet.addEventListener('click', function() {
      document.querySelectorAll('.d99-scaffold-bullets span').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      const idx = this.innerText;
      document.querySelectorAll('.d99-scaffold-img-item').forEach(img => {
        img.classList.remove('active');
        if (img.getAttribute('data-index') == idx) {
          img.classList.add('active');
        }
      });
    });
  });

  function selectSize(btn, variantId) {
    document.querySelectorAll('.d99-brutalist-size-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('d99-variant-id').value = variantId;
  }

  function openSizeModal() {
    document.getElementById('d99-size-modal').style.display = 'block';
  }

  function closeSizeModal() {
    document.getElementById('d99-size-modal').style.display = 'none';
  }

  window.onclick = function(event) {
    const modal = document.getElementById('d99-size-modal');
    if (event.target == modal) {
      modal.style.display = 'none';
    }
  }
</script>
