{% comment %}
  DISTRICT-99 (D99) - CYBER-BRUTALIST COLLECTION PAGE SECTION (MATCHING collection_page_option_3.jpg)
  Blueprint style borderless layout, pattern scale schematics, and model hover swap.
{% endcomment %}

<div class="d99-brutalist-collection-wrapper">
  
  <!-- TOP STATUS BAR -->
  <div class="d99-status-bar">
    <div class="d99-status-cell">D99</div>
    <div class="d99-status-cell">// DISTRICT-99&reg;<br>SECTION: APPAREL</div>
    <div class="d99-status-cell">// COLLECTION ARCHIVE<br>[{{ collection.title | upcase }}]</div>
    <div class="d99-status-cell">STATUS: ONLINE<br>VIEW_MODE: TECHNICAL</div>
    <div class="d99-status-cell d99-red-marker">&times;</div>
  </div>

  <div class="d99-collection-container container">
    
    <!-- COLLECTION HEADER -->
    <header class="d99-collection-page-header">
      <div class="d99-collection-h-left">
        <span class="d99-meta-label">// SS25 COLLECTION</span>
        <h1 class="d99-collection-brutalist-title">INFRASTRUCTURE // 25-01</h1>
      </div>
      <div class="d99-collection-h-right">
        <span class="d99-meta-label">COLLECTION PAGE 03</span>
        <span class="d99-system-tag">GRID_SYSTEM v2.5</span>
      </div>
    </header>

    <!-- BRUTALIST GRID -->
    <div class="d99-brutalist-collection-grid">
      
      {% for product in collection.products limit: 2 %}
        
        <!-- CARD 1 & 3: Product Model Cards -->
        <div class="d99-brutalist-card">
          <span class="d99-card-index">// 0{{ forloop.index }} / FIELD ENVIRONMENT</span>
          
          <a href="{{ product.url }}" class="d99-collection-card-link">
            <!-- Scaffold Image Frame with hover transition -->
            <div class="d99-collection-img-frame">
              <!-- Grid crosshairs -->
              <div class="d99-ch-t">+</div>
              <div class="d99-ch-b">+</div>
              
              {% if product.images.size > 1 %}
                <img src="{{ product.featured_image | img_url: 'master' }}" class="d99-grid-img-featured" alt="{{ product.title }}">
                <img src="{{ product.images[1] | img_url: 'master' }}" class="d99-grid-img-hover" alt="{{ product.title }}">
              {% else %}
                <img src="{{ product.featured_image | img_url: 'master' }}" class="d99-grid-img-single" alt="{{ product.title }}">
              {% endif %}
              
              {% unless product.available %}
                <div class="d99-grid-sold-out">SOLD OUT</div>
              {% endunless %}
            </div>

            <!-- Card Bottom Spec Matrix -->
            <div class="d99-card-spec-panel">
              <span class="d99-card-prod-title">{{ product.title | upcase }}</span>
              <table class="d99-card-spec-table">
                <thead>
                  <tr>
                    <th>SIZE GRID (CM)</th>
                    <th>XS</th><th>S</th><th>M</th><th>L</th><th>XL</th><th>XXL</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td>CHEST</td><td>52</td><td>54</td><td>56</td><td>58</td><td>60</td><td>62</td></tr>
                  <tr><td>LENGTH</td><td>68</td><td>70</td><td>72</td><td>74</td><td>76</td><td>78</td></tr>
                  <tr><td>SHOULDER</td><td>48</td><td>50</td><td>52</td><td>54</td><td>56</td><td>58</td></tr>
                  <tr><td>SLEEVE</td><td>20</td><td>21</td><td>22</td><td>23</td><td>24</td><td>25</td></tr>
                </tbody>
              </table>
              
              <div class="d99-card-price-row">
                <span class="d99-card-price">{{ product.price | money }}</span>
                <span class="d99-card-view-btn">VIEW MODULE [ &nearr; ]</span>
              </div>
            </div>
          </a>
        </div>

        <!-- CARD 2: MIDDLE COLUMN Technical Pattern Drawing (Figma/Ssense style) -->
        {% if forloop.first %}
          <div class="d99-brutalist-card d99-technical-flat-card">
            <span class="d99-card-index">// 02 / TECHNICAL FLAT</span>
            
            <div class="d99-technical-flat-frame">
              <span class="d99-tf-label">T-SHIRT_01<br>TECHNICAL FLAT / FRONT</span>
              <span class="d99-tf-scale">SCALE: 1:4</span>
              
              <!-- Blueprint Pattern SVG Line Drawing -->
              <svg viewBox="0 0 200 200" class="d99-pattern-svg">
                <!-- Outer limits -->
                <rect x="10" y="10" width="180" height="180" stroke="rgba(255,255,255,0.05)" stroke-dasharray="2,2" fill="none"/>
                <!-- T-shirt outline -->
                <path d="M 60,40 Q 100,30 140,40 L 175,65 Q 185,85 165,100 L 150,90 L 150,165 Q 100,165 50,165 L 50,90 L 35,100 Q 15,85 25,65 Z" stroke="rgba(255,255,255,0.4)" stroke-width="1" fill="none"/>
                <!-- Ribbed Collar -->
                <path d="M 75,40 Q 100,52 125,40 M 76,43 Q 100,55 124,43" stroke="rgba(255,255,255,0.4)" stroke-width="1" fill="none"/>
                <!-- Raglan Shoulder seams -->
                <path d="M 75,40 L 50,90 M 125,40 L 150,90" stroke="rgba(255,255,255,0.25)" stroke-dasharray="2,2" fill="none"/>
                <!-- Coverstitch lines bottom -->
                <path d="M 50,161 L 150,161 M 50,163 L 150,163" stroke="rgba(255,255,255,0.25)" stroke-width="0.5" fill="none"/>
                <!-- Red Dimension guidelines (Matches collection_page_option_3.jpg!) -->
                <!-- Width indicator -->
                <line x1="50" y1="175" x2="150" y2="175" stroke="#e50914" stroke-width="0.5"/>
                <text x="100" y="185" fill="#e50914" font-size="8" text-anchor="middle" font-family="monospace">58.0</text>
                <!-- Length indicator -->
                <line x1="162" y1="90" x2="162" y2="165" stroke="#e50914" stroke-width="0.5"/>
                <text x="172" y="130" fill="#e50914" font-size="8" text-anchor="middle" font-family="monospace" transform="rotate(90,172,130)">72.0</text>
                <!-- Sleeve indicator -->
                <line x1="140" y1="40" x2="175" y2="65" stroke="#e50914" stroke-width="0.5"/>
                <text x="165" y="48" fill="#e50914" font-size="8" font-family="monospace">21.0</text>
              </svg>
            </div>

            <!-- Card Bottom Fabric / construction specification data sheet -->
            <div class="d99-card-spec-panel d99-tf-details">
              <div class="d99-tf-spec-grid">
                <div>
                  <span class="d99-tf-spec-title">FABRIC:</span>
                  <p>COTTON_JERSEY_240GSM<br>100% COMBED COTTON</p>
                </div>
                <div>
                  <span class="d99-tf-spec-title">CONSTRUCTION:</span>
                  <p>OVERLOCK_SEAMS<br>COVERSTITCH_HEMS</p>
                </div>
                <div>
                  <span class="d99-tf-spec-title">FINISH:</span>
                  <p>GARMENT_DYE<br>WASHED</p>
                </div>
                <div>
                  <span class="d99-tf-spec-title">DETAILS:</span>
                  <p>REFLECTIVE_PRINT<br>D99_LOGO_FRONT</p>
                </div>
              </div>
            </div>
          </div>
        {% endif %}

      {% endfor %}

    </div>
  </div>
</div>

<style>
  /* ----------------------------------------------------
     D99 Cyber-Brutalist Collection Page Styling
     ---------------------------------------------------- */
  .d99-brutalist-collection-wrapper {
    background-color: #080808;
    color: #ffffff;
    width: 100%;
  }

  /* 1. Header */
  .d99-collection-page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding: 30px 0 15px 0;
    margin-bottom: 40px;
  }
  .d99-meta-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #e50914;
    display: block;
    margin-bottom: 5px;
    letter-spacing: 0.1em;
  }
  .d99-collection-brutalist-title {
    font-family: var(--font-heading) !important;
    font-size: 32px !important;
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .d99-system-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #525252;
    font-weight: bold;
    display: block;
  }

  /* 2. Grid Layout (3 Columns) */
  .d99-brutalist-collection-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    width: 100%;
  }

  /* Card */
  .d99-brutalist-card {
    display: flex;
    flex-direction: column;
    background-color: #141414;
    border: 1px solid rgba(255,255,255,0.08);
    overflow: hidden;
  }
  .d99-card-index {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #525252;
    padding: 12px 18px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    display: block;
  }
  .d99-collection-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Image Frame & Hover Transition */
  .d99-collection-img-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .d99-ch-t, .d99-ch-b {
    position: absolute;
    color: #e50914;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: bold;
    z-index: 10;
  }
  .d99-ch-t { top: 10px; left: 15px; }
  .d99-ch-b { bottom: 10px; right: 15px; }

  .d99-grid-img-featured {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .d99-grid-img-hover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .d99-collection-card-link:hover .d99-grid-img-featured {
    opacity: 0;
  }
  .d99-collection-card-link:hover .d99-grid-img-hover {
    opacity: 1;
  }

  .d99-grid-sold-out {
    position: absolute;
    inset: 0;
    background-color: rgba(0,0,0,0.6);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.1em;
    z-index: 15;
  }

  /* Spec Matrix */
  .d99-card-spec-panel {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    flex: 1;
    justify-content: space-between;
  }
  .d99-card-prod-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 800;
    color: #ffffff;
    display: block;
    letter-spacing: 0.05em;
  }
  .d99-card-spec-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 9px;
    color: #737373;
  }
  .d99-card-spec-table th, .d99-card-spec-table td {
    border: 1px solid rgba(255,255,255,0.05);
    padding: 5px;
    text-align: center;
  }
  .d99-card-spec-table th {
    color: #e50914;
    font-weight: bold;
  }
  .d99-card-price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-top: 12px;
  }
  .d99-card-price {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: bold;
    color: #ffffff;
  }
  .d99-card-view-btn {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #e50914;
    font-weight: bold;
  }

  /* Middle Technical Card specific */
  .d99-technical-flat-card {
    background-color: #0c0c0c;
  }
  .d99-technical-flat-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    display: flex;
    flex-direction: column;
    padding: 20px;
    justify-content: space-between;
  }
  .d99-tf-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #fff;
    line-height: 1.3;
    font-weight: bold;
  }
  .d99-tf-scale {
    position: absolute;
    top: 20px;
    right: 20px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: #525252;
  }
  .d99-pattern-svg {
    width: 100%;
    max-height: 240px;
    margin-top: 10px;
  }
  .d99-tf-spec-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: #737373;
  }
  .d99-tf-spec-title {
    color: #e50914;
    font-weight: bold;
    display: block;
    margin-bottom: 3px;
  }

  @media screen and (max-width: 990px) {
    .d99-brutalist-collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .d99-technical-flat-card {
      display: none; /* Hide technical pattern grid on tablets/mobile to keep it compact */
    }
  }

  @media screen and (max-width: 600px) {
    .d99-brutalist-collection-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
