<style>
  /* ----------------------------------------------------
     D99 Asymmetrical Bento Grid Lookbook Styling
     ---------------------------------------------------- */
  .d99-bento-wrapper {
    padding: 80px 0;
    width: 100%;
  }

  .d99-section-title {
    font-family: 'Syne', sans-serif !important;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    text-transform: uppercase;
    color: #000000;
    margin-bottom: 50px;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  /* 4-column base grid with automatic row flows */
  .d99-bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(280px, auto);
    gap: 30px;
    width: 100%;
  }

  /* Asymmetrical Item Spans */
  .d99-bento-featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .d99-bento-wide {
    grid-column: span 2;
  }

  /* Individual Bento Card */
  .d99-bento-item {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border: 1px solid #000000; /* Sharp, minimal black border */
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    overflow: hidden;
  }

  .d99-bento-item:hover {
    transform: translateY(-5px);
    box-shadow: 0px 15px 45px rgba(0,0,0,0.08);
  }

  /* Image Container with light-grey background */
  .d99-bento-img-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    background-color: #f7f7f7;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid #000000;
  }

  .d99-bento-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .d99-bento-item:hover .d99-bento-img {
    transform: scale(1.06); /* Interactive zoom */
  }

  /* Card Footer Details: Title on Left, Interactive CTA on Right */
  .d99-bento-details {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    background-color: #ffffff;
    font-family: 'Space Grotesk', sans-serif;
  }

  .d99-bento-title {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: #000000;
    letter-spacing: 0.02em;
  }

  /* Red/Black Interactive CTA instead of price */
  .d99-bento-cta {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: #e50914; /* DISTRICT-99 Red */
    letter-spacing: 0.1em;
    border-bottom: 1px solid #e50914;
    padding-bottom: 2px;
    transition: all 0.3s ease;
  }

  .d99-bento-item:hover .d99-bento-cta {
    color: #000000;
    border-color: #000000;
  }

  /* Responsive styling for Mobile & Editor */
  @media screen and (max-width: 1024px) {
    .d99-bento-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      grid-auto-rows: minmax(220px, auto) !important;
      gap: 20px !important;
    }
  }

  @media screen and (max-width: 600px) {
    .d99-bento-grid {
      display: flex !important;
      flex-direction: column !important;
      gap: 20px !important;
    }
  }
</style>

