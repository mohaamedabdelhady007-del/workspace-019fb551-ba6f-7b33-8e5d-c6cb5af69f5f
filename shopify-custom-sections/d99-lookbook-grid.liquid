            {% assign panel_img_1 = section.settings.image_1 | img_url: 'master' %}
          {% else %}
            {% assign panel_img_1 = 'bento_panel_1.png' | asset_img_url: 'master' %}
          {% endif %}
          <img src="{{ panel_img_1 }}" alt="{{ section.settings.title_1 }}" class="d99-bento-img">
        </div>
        <div class="d99-bento-details">
          <span class="d99-bento-title">{{ section.settings.title_1 }}</span>
          <span class="d99-bento-cta">{{ section.settings.cta_1 }}</span>
