{% comment %}
  DISTRICT-99 (D99) - PREMIUM EDITORIAL LOOKBOOK GRID SECTION
  Custom Shopify Liquid Section (Online Store 2.0 compatible)
  This implements the 5-panel lookbook grid (2 columns on top, 3 columns on bottom)
  Place this inside your theme's 'sections/' folder as 'd99-lookbook-grid.liquid'
{% endcomment %}

<div class="d99-lookbook-wrapper" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="d99-section-title">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="d99-lookbook-grid">
      
      <!-- Panel 1 (Top Left) -->
      <div class="d99-lookbook-item d99-col-top">
        <div class="d99-item-image-wrapper">
          <img src="{{ section.settings.image_1 | img_url: 'master' }}" alt="{{ section.settings.title_1 }}" class="d99-item-img">
        </div>
        <div class="d99-item-details">
          <span class="d99-item-title">{{ section.settings.title_1 }}</span>
          <span class="d99-item-price">{{ section.settings.price_1 }}</span>
        </div>
      </div>
      
      <!-- Panel 2 (Top Right) -->
      <div class="d99-lookbook-item d99-col-top">
        <div class="d99-item-image-wrapper">
          <img src="{{ section.settings.image_2 | img_url: 'master' }}" alt="{{ section.settings.title_2 }}" class="d99-item-img">
        </div>
        <div class="d99-item-details">
          <span class="d99-item-title">{{ section.settings.title_2 }}</span>
          <span class="d99-item-price">{{ section.settings.price_2 }}</span>
        </div>
      </div>
      
      <!-- Panel 3 (Bottom Left) -->
      <div class="d99-lookbook-item d99-col-bottom">
        <div class="d99-item-image-wrapper">
          <img src="{{ section.settings.image_3 | img_url: 'master' }}" alt="{{ section.settings.title_3 }}" class="d99-item-img">
        </div>
        <div class="d99-item-details">
          <span class="d99-item-title">{{ section.settings.title_3 }}</span>
          <span class="d99-item-price">{{ section.settings.price_3 }}</span>
        </div>
      </div>
      
      <!-- Panel 4 (Bottom Center) -->
      <div class="d99-lookbook-item d99-col-bottom">
        <div class="d99-item-image-wrapper">
          <img src="{{ section.settings.image_4 | img_url: 'master' }}" alt="{{ section.settings.title_4 }}" class="d99-item-img">
        </div>
        <div class="d99-item-details">
          <span class="d99-item-title">{{ section.settings.title_4 }}</span>
          <span class="d99-item-price">{{ section.settings.price_4 }}</span>
        </div>
      </div>
      
      <!-- Panel 5 (Bottom Right) -->
      <div class="d99-lookbook-item d99-col-bottom">
        <div class="d99-item-image-wrapper">
          <img src="{{ section.settings.image_5 | img_url: 'master' }}" alt="{{ section.settings.title_5 }}" class="d99-item-img">
        </div>
        <div class="d99-item-details">
          <span class="d99-item-title">{{ section.settings.title_5 }}</span>
          <span class="d99-item-price">{{ section.settings.price_5 }}</span>
        </div>
      </div>
      
    </div>
  </div>
</div>

<style>
  /* ----------------------------------------------------
     D99 Lookbook Grid Layout (2 Top, 3 Bottom)
     ---------------------------------------------------- */
  .d99-lookbook-wrapper {
    padding: 60px 0;
    width: 100%;
  }

  .d99-section-title {
    font-family: 'Syne', sans-serif !important;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    text-transform: uppercase;
    color: #000000;
    margin-bottom: 40px;
    letter-spacing: -0.01em;
  }

  /* Grid Layout Configuration */
  .d99-lookbook-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr); /* 6 column base grid */
    gap: 30px;
    width: 100%;
  }

  /* Top Row Items (2 Columns): Spans 3 columns each out of 6 */
  .d99-col-top {
    grid-column: span 3;
  }

  /* Bottom Row Items (3 Columns): Spans 2 columns each out of 6 */
  .d99-col-bottom {
    grid-column: span 2;
  }

  /* Individual Card Styling */
  .d99-lookbook-item {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border: 1px solid #000000; /* Crisp thin border around the entire card */
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .d99-lookbook-item:hover {
    transform: translateY(-5px);
    box-shadow: 0px 12px 36px rgba(0,0,0,0.08);
  }

  /* Image Container with light-grey background */
  .d99-item-image-wrapper {
    width: 100%;
    position: relative;
    background-color: #f7f7f7; /* Matching Transparent Product PNG backgrounds */
    overflow: hidden;
    aspect-ratio: 3/4; /* Elegant vertical aspect ratio */
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid #000000; /* Border separating image and text */
  }

  .d99-item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .d99-lookbook-item:hover .d99-item-img {
    transform: scale(1.05); /* Interactive zoom on hover */
  }

  /* Card Footer Details: Title on Left, Price on Right */
  .d99-item-details {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background-color: #ffffff;
    font-family: 'Space Grotesk', sans-serif;
  }

  .d99-item-title {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: #000000;
    letter-spacing: 0.02em;
  }

  .d99-item-price {
    font-size: 14px;
    font-weight: 700;
    color: #000000;
  }

  /* Mobile Responsiveness: Stack all items to 1 column */
  @media screen and (max-width: 768px) {
    .d99-lookbook-grid {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .d99-item-details {
      padding: 12px 15px;
    }
  }
</style>

